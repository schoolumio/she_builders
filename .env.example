# ---------------------------------------------------------------------------------------------
# Prayer Community Platform — environment variables
# Copy to `.env` and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------------------------

# development | staging | production. Controls simulator availability and safety checks.
APP_ENV=development
# Public base URL of the app (used in emails, payment callbacks, invitation links). No trailing slash.
APP_URL=http://localhost:3000

# PostgreSQL connection string. On Neon: the pooled (-pooler) string for the app, and the direct
# string in DATABASE_URL_UNPOOLED for migrations (`neon deploy` / `neon env pull` write both).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/prayer_dev?schema=public
DATABASE_URL_UNPOOLED=

# 32+ random bytes, base64. Used to encrypt sensitive stored fields and sign unsubscribe links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared secret required by /api/cron/tick (send as `Authorization: Bearer <secret>`).
CRON_SECRET=

# Platform staff must use two-factor authentication. Defaults to true when APP_ENV=production.
PLATFORM_REQUIRE_MFA=
# Audit-log retention in days (default 730). Financial records are never purged automatically.
AUDIT_RETENTION_DAYS=730
# Optional: POST a short JSON alert here for every unhandled server error (e.g. a Slack webhook).
ERROR_WEBHOOK_URL=

# --- Branding (optional; defaults live in src/config/brand.ts) --------------------------------
BRAND_PRODUCT_NAME=AltarCall
BRAND_SHORT_NAME=AltarCall
# Part of the short name shown in gold in the logo wordmark (leave empty for a single colour).
BRAND_WORDMARK_ACCENT=Call
BRAND_TAGLINE=Where prayer communities come together.
BRAND_COMPANY_NAME=BridgeCodes
BRAND_LEGAL_ENTITY=Numi Innovations Ltd
BRAND_SUPPORT_EMAIL=support@example.com
SECURITY_CONTACT_EMAIL=security@example.com

# --- Email ------------------------------------------------------------------------------------
# log = print to server console (development); resend = Resend HTTP API.
EMAIL_DRIVER=log
EMAIL_FROM="Prayer Community Platform <no-reply@example.com>"
RESEND_API_KEY=

# --- File storage -----------------------------------------------------------------------------
# local = ./storage directory (development only); s3 = any S3-compatible object store;
# database = small images kept in Postgres (demos/staging on hosts without a disk, e.g. Vercel);
# neon = Neon Object Storage bucket from neon.ts (uses the AWS_* variables below).
STORAGE_DRIVER=local
# Neon Object Storage (written by `neon deploy` / `neon env pull`). Bucket defaults to "assets".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=assets
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Real-time meetings (LiveKit Cloud or self-hosted) ---------------------------------------
# Leave blank to show an honest "in-app meetings not configured" state.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Donations: Paystack (subaccounts + split payments) --------------------------------------
# Use sk_test_ keys until Paystack has approved the account for this use case.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Donations: Stripe Connect (direct charges on connected accounts) ------------------------
STRIPE_SECRET_KEY=
# Signing secret for the Connect webhook endpoint (/api/webhooks/stripe/connect).
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Browser push notifications (Web Push / VAPID) -------------------------------------------
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Leave blank to hide browser notifications (in-app and email still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:support@yourdomain.example
VAPID_SUBJECT=

# --- Development-only payment simulator --------------------------------------------------------
# Never available when APP_ENV=production.
PAYMENTS_SIMULATOR_ENABLED=true
PAYMENTS_SIMULATOR_SECRET=dev-simulator-secret-change-me

# --- SaaS subscription billing (Stripe Billing) -----------------------------------------------
# none = billing not configured (platform admins assign plans manually); stripe = Stripe Billing.
BILLING_PROVIDER=none
# Signing secret for the billing webhook endpoint (/api/webhooks/stripe/billing).
STRIPE_BILLING_WEBHOOK_SECRET=
